{
  "name": "轻小说文库 · 网页版",
  "short_name": "文库",
  "description": "无需登录的轻小说文库网页阅读器，支持整本下载与断网离线阅读。",
  "lang": "zh-CN",
  "id": "/",
  "start_url": "/#/home",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait",
  "background_color": "#f4efe5",
  "theme_color": "#f4efe5",
  "categories": ["books", "entertainment"],
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icons/apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png"
    }
  ],
  "shortcuts": [
    {
      "name": "书架",
      "short_name": "书架",
      "url": "/#/shelf",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "离线书架",
      "short_name": "离线",
      "url": "/#/offline",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    }
  ]
}
